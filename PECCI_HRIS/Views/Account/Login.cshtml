@model PECCI_HRIS.Models.LoginViewModel

@{
    // Removes the Admin sidebar and top navbar for the login screen
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - PECCI HRIS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body class="login-body">

    <div class="container-fluid d-flex align-items-center justify-content-center" style="min-height: 100vh;">
        <div class="login-card">
            <h1 class="login-title mb-4">PECCI Human Resources<br />Information System</h1>

            <p class="login-welcome">Welcome, KaPECCI!</p>
            <p class="login-instruction mb-4">Please input your username and password.</p>

            <form asp-action="Login" method="post" autocomplete="off">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                <div class="mb-3">
                    <input asp-for="UserName" class="form-control py-2 border-0 shadow-sm login-input"
                           placeholder="Username" required />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div class="mb-4 position-relative">
                    <input asp-for="Password" type="password" id="passwordInput"
                           class="form-control py-2 border-0 shadow-sm login-input"
                           placeholder="Password" required />

                    <i class="bi bi-eye password-toggle-icon position-absolute top-50 end-0 translate-middle-y me-3"
                       onclick="togglePasswordVisibility(event)"></i>

                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="login-btn mb-3 text-uppercase">Login</button>

                <div class="mt-2">
                    <a href="#" class="forgot-password">Forgot Password?</a>
                </div>
            </form>
        </div>
    </div>

    <script>
        function togglePasswordVisibility(e) {
            const passwordField = document.getElementById("passwordInput");
            const icon = e.target;

            if (passwordField.type === "password") {
                passwordField.type = "text";
                icon.classList.replace("bi-eye", "bi-eye-slash");
            } else {
                passwordField.type = "password";
                icon.classList.replace("bi-eye-slash", "bi-eye");
            }
        }
    </script>

</body>
</html>