<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PECCI_HRIS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PECCI_HRIS.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body>
    <div class="d-flex flex-row" style="min-height: 100vh;">

        <nav class="d-flex flex-column flex-shrink-0 p-3 bg-light border-end" style="width: 250px;">
            <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto link-dark text-decoration-none">
                <span class="fs-4 fw-bold">HRIS <br /><small class="fw-normal fs-6 text-muted">Admin</small></span>
            </a>
            <hr>
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item">
                    <a asp-controller="Dashboard" asp-action="Index" class="nav-link active" aria-current="page">
                        <i class="bi bi-house-door me-2"></i> Dashboard
                    </a>
                </li>

                <li class="nav-item mt-2">
                    <span class="nav-link link-dark fw-bold pb-1">
                        <i class="bi bi-people me-2"></i> Employees
                    </span>
                    <ul class="nav flex-column ms-4 mb-2">
                        <li class="nav-item">
                            <a asp-controller="Leave" asp-action="Apply" class="nav-link link-dark py-1">Leaves</a>
                        </li>
                        <li class="nav-item">
                            <a href="#" class="nav-link link-dark py-1">Overtime</a>
                        </li>
                    </ul>
                </li>

                <li class="nav-item">
                    <a href="#" class="nav-link link-dark">
                        <i class="bi bi-person-badge me-2"></i> Attendance
                    </a>
                </li>

                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a href="#" class="nav-link link-dark">
                            <i class="bi bi-cash me-2"></i> Payroll
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="#" class="nav-link link-dark">
                            <i class="bi bi-calendar3 me-2"></i> Calendar
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="#" class="nav-link link-dark">
                            <i class="bi bi-gear me-2"></i> Settings
                        </a>
                    </li>
                }
            </ul>
            <hr>
            <div class="dropdown">
                <a asp-controller="Account" asp-action="Logout" class="d-flex align-items-center link-dark text-decoration-none">
                    <i class="bi bi-box-arrow-right me-2 text-danger"></i>
                    <strong class="text-danger">Logout</strong>
                </a>
            </div>
        </nav>

        <div class="flex-grow-1 d-flex flex-column">
            <main role="main" class="flex-grow-1 p-4">
                @RenderBody()
            </main>

            <footer class="border-top footer text-muted mt-auto">
                <div class="container-fluid p-3 text-center">
                    &copy; 2026 - PECCI_HRIS - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>