<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PECCI_HRIS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PECCI_HRIS.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body style="overflow-x: hidden;">
    <div class="d-flex flex-row" style="min-height: 100vh;">

        <nav class="sidebar-admin d-flex flex-column flex-shrink-0 p-3 shadow" style="width: 260px;">
            <div class="sidebar-logo-card d-flex align-items-center shadow-sm mb-4">
                <div class="position-relative">
                    <div class="bg-success rounded-circle d-flex align-items-center justify-content-center border border-2 border-white" style="width: 50px; height: 50px;">
                        <i class="bi bi-person-fill text-white fs-4"></i>
                    </div>
                    <span class="position-absolute bottom-0 end-0 p-1 bg-success border border-white rounded-circle"></span>
                </div>
                <div class="ms-3">
                    <h5 class="mb-0 fw-bold text-dark" style="letter-spacing: 0.5px; font-size: 0.9rem;">HRIS</h5>
                    <small class="text-muted fw-bold">@(User.IsInRole("Admin") ? "Admin" : "Employee")</small>
                </div>
            </div>

            <p class="text-white-50 small fw-bold mb-2 ps-2" style="font-size: 0.7rem;">MAIN MENU</p>

            <ul class="nav flex-column mb-auto" id="sidebarNav">
                <li class="nav-item">
                    <a asp-controller="Dashboard" asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")">
                        <i class="bi bi-house-door"></i> Dashboard
                    </a>
                </li>

                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Account" && ViewContext.RouteData.Values["Action"]?.ToString() != "Logout" ? "active" : "")"
                           data-bs-toggle="collapse" href="#accountsMenu" role="button">
                            <i class="bi bi-person-lock"></i> Accounts
                        </a>
                        <div class="collapse @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Account" && ViewContext.RouteData.Values["Action"]?.ToString() != "Logout" ? "show" : "")" id="accountsMenu">
                            <ul class="nav flex-column sidebar-submenu">
                                <li><a asp-controller="Account" asp-action="Profile" class="nav-link">Profile</a></li>
                                <li><a asp-controller="Account" asp-action="UserManagement" class="nav-link">Employees Profile</a></li>
                            </ul>
                        </div>
                    </li>
                }

                <li class="nav-item">
                    <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Leave" ? "active" : "")"
                       data-bs-toggle="collapse" href="#employeesMenu" role="button">
                        <i class="bi bi-people"></i> @(User.IsInRole("Admin") ? "Employees" : "My Requests")
                    </a>
                    <div class="collapse @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Leave" ? "show" : "")" id="employeesMenu">
                        <ul class="nav flex-column sidebar-submenu">
                            <li><a asp-controller="Leave" asp-action="Apply" class="nav-link">Leave Requests</a></li>
                            <li><a href="#" class="nav-link">Overtime Requests</a></li>
                        </ul>
                    </div>
                </li>

                <li class="nav-item">
                    <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Attendance" ? "active" : "")"
                       data-bs-toggle="collapse" href="#attendanceMenu" role="button">
                        <i class="bi bi-clock"></i> @(User.IsInRole("Admin") ? "Attendance" : "My Attendance")
                    </a>
                    <div class="collapse @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Attendance" ? "show" : "")" id="attendanceMenu">
                        <ul class="nav flex-column sidebar-submenu">
                            <li><a asp-controller="Attendance" asp-action="DailyLogs" class="nav-link">Daily Logs</a></li>
                        </ul>
                    </div>
                </li>

                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Payroll" ? "active" : "")"
                           data-bs-toggle="collapse" href="#payrollMenu" role="button">
                            <i class="bi bi-cash-stack"></i> Payroll
                        </a>
                        <div class="collapse @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Payroll" ? "show" : "")" id="payrollMenu">
                            <ul class="nav flex-column sidebar-submenu">
                                <li><a asp-controller="Payroll" asp-action="GrossPay" class="nav-link">Gross Pay</a></li>
                                <li><a asp-controller="Payroll" asp-action="Benefits" class="nav-link">Benefits</a></li>
                            </ul>
                        </div>
                    </li>

                    <li class="nav-item">
                        <a asp-controller="Calendar" asp-action="Index"
                           class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Calendar" ? "active" : "")">
                            <i class="bi bi-calendar3"></i> Calendar
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-controller="Settings" asp-action="Index"
                           class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Settings" ? "active" : "")">
                            <i class="bi bi-gear"></i> Settings
                        </a>
                    </li>
                }
            </ul>

            <hr class="text-white-50">
            <div class="pb-2">
                <a asp-controller="Account" asp-action="Logout" class="nav-link text-white">
                    <i class="bi bi-box-arrow-right text-danger"></i>
                    <span class="text-danger fw-bold">Logout</span>
                </a>
            </div>
        </nav>

        <div class="flex-grow-1 d-flex flex-column bg-light" style="overflow-x: hidden;">

            <nav class="navbar navbar-expand-lg px-4 py-3 shadow-sm" style="background-color: #2D4A36;">
                <div class="container-fluid d-flex justify-content-between align-items-center p-0">
                    <h3 class="text-white mb-0 fw-bold">@ViewData["Title"]</h3>

                    <div class="d-flex align-items-center">
                        <div class="position-relative" style="cursor: pointer;">
                            <i class="bi bi-bell-fill" style="color: #FF8A3D; font-size: 1.5rem;"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-circle bg-success border border-white"
                                  style="padding: 0.25em 0.4em; font-size: 0.6rem;">
                                1
                            </span>
                        </div>
                    </div>
                </div>
            </nav>

            <main role="main" class="flex-grow-1 p-4">
                @RenderBody()
            </main>

            <footer class="footer text-muted bg-white border-top w-100">
                <div class="container-fluid p-3 text-center small">
                    &copy; 2026 - PECCI_HRIS - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const navLinks = document.querySelectorAll(".sidebar-admin .nav-link");
            navLinks.forEach(link => {
                link.addEventListener("click", function() {
                    if(!this.classList.contains('active')) {
                        navLinks.forEach(l => l.classList.remove("active"));
                        this.classList.add("active");
                    }
                });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>