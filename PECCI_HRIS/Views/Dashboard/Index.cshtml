@model PECCI_HRIS.Models.DashboardViewModel

@{
    // Dynamically set the title based on the user's role
    ViewData["Title"] = User.IsInRole("Admin") ? "Admin Dashboard" : "Employee Dashboard";
}

<div class="container-fluid pt-2">
    <p class="text-success fw-bold mb-4">Welcome, @(Model.User?.userName ?? "User")!</p>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-white" style="background-color: #5D78FF; border-radius: 12px;">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <h2 class="fw-bold mb-0">@Model.TotalEmployees</h2>
                        <small class="opacity-75">@(User.IsInRole("Admin") ? "Total Employees" : "My Requests")</small>
                    </div>
                    <i class="bi bi-people-fill fs-1 opacity-50"></i>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-white" style="background-color: #00C853; border-radius: 12px;">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <h2 class="fw-bold mb-0">@Model.ActiveEmployees</h2>
                        <small class="opacity-75">@(User.IsInRole("Admin") ? "Active Employees" : "Approved")</small>
                    </div>
                    <i class="bi bi-person-check-fill fs-1 opacity-50"></i>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-white" style="background-color: #A349A4; border-radius: 12px;">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <h2 class="fw-bold mb-0">@Model.TotalDepartments</h2>
                        <small class="opacity-75">@(User.IsInRole("Admin") ? "Departments" : "Available Credits")</small>
                    </div>
                    <i class="bi bi-building fs-1 opacity-50"></i>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-white" style="background-color: #FF8A3D; border-radius: 12px;">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <h2 class="fw-bold mb-0">@Model.RecentHiresCount</h2>
                        <small class="opacity-75">@(User.IsInRole("Admin") ? "Recent Hires" : "Pending Status")</small>
                    </div>
                    <i class="bi bi-briefcase-fill fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius: 15px;">
        <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">@(User.IsInRole("Admin") ? "Recent Employees" : "My Recent Requests")</h5>

            <div class="d-flex align-items-center">
                <div class="input-group me-2" style="width: 250px;">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control bg-light border-0" placeholder="Search...">
                </div>
                <button class="btn btn-light border-0 rounded-circle"><i class="bi bi-filter"></i></button>
            </div>
        </div>

        <div class="card-body p-0 mt-3">
            <table class="table align-middle mb-0">
                <thead style="background-color: #58D68D; color: white;">
                    <tr>
                        <th class="ps-4 py-3 text-uppercase small fw-bold">@(User.IsInRole("Admin") ? "Employee" : "Request Type")</th>
                        <th class="text-uppercase small fw-bold">@(User.IsInRole("Admin") ? "Department" : "Date")</th>
                        <th class="text-uppercase small fw-bold">Status</th>
                        <th class="text-center text-uppercase small fw-bold">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentEmployees != null && Model.RecentEmployees.Any())
                    {
                        @foreach (var item in Model.RecentEmployees)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle me-3 overflow-hidden bg-light border" style="width: 45px; height: 45px;">
                                            <i class="bi bi-person-fill text-secondary fs-3 d-flex justify-content-center mt-1"></i>
                                        </div>
                                        <span class="fw-bold text-dark">@item.FullName</span>
                                    </div>
                                </td>
                                <td><span class="text-muted">@item.Department</span></td>
                                <td>
                                    @if (item.Status == "On Leave" || item.Status == "Pending")
                                    {
                                        <span class="badge rounded-pill bg-warning text-dark px-3 py-2">@item.Status</span>
                                    }
                                    else if (item.Status == "Active" || item.Status == "Approved")
                                    {
                                        <span class="badge rounded-pill bg-success-light text-success px-3 py-2" style="background-color: #D5F5E3;">@item.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary text-white px-3 py-2">@item.Status</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a href="#" class="btn btn-link text-dark p-1"><i class="bi bi-eye fs-5"></i></a>
                                    <a href="#" class="btn btn-link text-dark p-1"><i class="bi bi-pencil-square fs-5"></i></a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5">
                                <p class="text-muted mb-0">No recent activity to display.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>